<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_direct_print" model="ir.ui.view">
        <field name="name">account.move.form.direct.print</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_invoice_sent']" position="after">
                <button name="action_print_invoice_direct" type="object" string="Imprimir factura directo"
                        invisible="move_type not in ('out_invoice', 'out_refund') or state != 'posted'"/>
            </xpath>
        </field>
    </record>
</odoo>
