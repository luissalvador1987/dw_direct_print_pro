<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_direct_print" model="ir.ui.view">
        <field name="name">stock.picking.form.direct.print</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm']" position="after">
                <button name="action_print_shipping_label_direct" type="object"
                        string="Imprimir etiqueta directo"
                        invisible="state in ('draft', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>
