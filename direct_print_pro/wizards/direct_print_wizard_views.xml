<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_direct_print_wizard_form" model="ir.ui.view">
        <field name="name">direct.print.wizard.form</field>
        <field name="model">direct.print.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="res_model" invisible="1"/>
                <field name="res_ids" invisible="1"/>
                <group>
                    <field name="record_count" string="Registros a imprimir" readonly="1"/>
                    <field name="report_id"/>
                    <field name="mode" widget="radio"/>
                    <field name="printer_id" invisible="mode != 'direct'" required="mode == 'direct'"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Imprimir" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Disponible desde el menú de Acción (⚙) de estos modelos, con el contexto ya armado. -->
    <record id="action_direct_print_wizard_sale" model="ir.actions.act_window">
        <field name="name">Imprimir directo</field>
        <field name="res_model">direct.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list,form</field>
        <field name="context">{'default_res_model': 'sale.order', 'default_res_ids': str(active_ids)}</field>
    </record>

    <record id="action_direct_print_wizard_partner" model="ir.actions.act_window">
        <field name="name">Imprimir directo</field>
        <field name="res_model">direct.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="context">{'default_res_model': 'res.partner', 'default_res_ids': str(active_ids)}</field>
    </record>

    <record id="action_direct_print_wizard_move" model="ir.actions.act_window">
        <field name="name">Imprimir directo</field>
        <field name="res_model">direct.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list,form</field>
        <field name="context">{'default_res_model': 'account.move', 'default_res_ids': str(active_ids)}</field>
    </record>

    <record id="action_direct_print_wizard_picking" model="ir.actions.act_window">
        <field name="name">Imprimir directo</field>
        <field name="res_model">direct.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_view_types">list,form</field>
        <field name="context">{'default_res_model': 'stock.picking', 'default_res_ids': str(active_ids)}</field>
    </record>
</odoo>
